APP_NAME="Friendly Friend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Behind a TLS reverse proxy: '*' or proxy IPs (comma-separated)
TRUSTED_PROXIES=
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Days and the activity heatmap on /stats use this timezone
STATS_TIMEZONE=Europe/Stockholm

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=friendly_friend
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=friendly-friend
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
# Where the APP publishes events (server to server): the reverb container.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Where BROWSERS connect, rendered into each page at runtime (config/reverb.php "browser").
# Prod: your public WebSocket host, 443, https. Unset host falls back to APP_URL's host.
REVERB_BROWSER_HOST=localhost
REVERB_BROWSER_PORT=8080
REVERB_BROWSER_SCHEME=http

# Discord (see docs/discord-app.md)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
# Your Discord user ID(s): always allowed in, manage servers on /admin/guilds
DISCORD_OWNER_IDS=
DISCORD_BOT_TOKEN=
# Start the bot service with `sail up` once the token is set:
# COMPOSE_PROFILES=bot

# Quote cleanup AI (optional; without keys quotes are parsed without AI)
QUOTES_AI_PROVIDERS=anthropic,openai,gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Jev (TypeSafe's decision model), always through OpenRouter (optional): quote
# detection in imports, what an @mention wants, picking between similar names
OPENROUTER_API_KEY=
